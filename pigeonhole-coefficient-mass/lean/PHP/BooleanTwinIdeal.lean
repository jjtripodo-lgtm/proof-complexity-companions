import PHP.LiteralBridge
import Mathlib.Algebra.MvPolynomial.Eval
import Mathlib.RingTheory.Ideal.Quotient.Defs
import Mathlib.RingTheory.Ideal.Maps

namespace PHP
set_option maxHeartbeats 1300000

open Finset MvPolynomial
open scoped BigOperators

abbrev TwinPolynomials (ι : Type*) (R : Type*) [CommRing R] := MvPolynomial (ι ⊕ ι) R

def boolValue {R : Type*} [Zero R] [One R] (b : Bool) : R := if b then 1 else 0

noncomputable def booleanTwinIdeal (ι : Type*) (R : Type*) [CommRing R] : Ideal (TwinPolynomials ι R) :=
  Ideal.span (Set.range (fun i : ι => (X (.inl i):TwinPolynomials ι R)^2-X (.inl i)) ∪
    Set.range (fun i : ι => (X (.inl i):TwinPolynomials ι R)+X (.inr i)-1))

noncomputable def assignmentEval {ι R : Type*} [CommRing R] (x : ι → Bool) :
    TwinPolynomials ι R →+* R :=
  eval₂Hom (RingHom.id R) (Sum.elim (fun i => boolValue (x i)) (fun i => 1-boolValue (x i)))

theorem assignmentEval_X {ι R : Type*} [CommRing R] (x : ι → Bool) (i : ι ⊕ ι) :
    assignmentEval (R:=R) x (X i) =
      Sum.elim (fun i => boolValue (x i)) (fun i => 1-boolValue (x i)) i := by
  simp [assignmentEval]

theorem assignmentEval_C {ι R : Type*} [CommRing R] (x : ι → Bool) (c : R) :
    assignmentEval x (C c) = c := by simp [assignmentEval]

/-- Exact Boolean/twin semantics, not a relaxation. On finitely many
cells, vanishing on all Boolean assignments is equivalent to membership
in the ideal generated by the uncharged Boolean and twin identities. -/
theorem boolean_twin_ideal_iff {ι R : Type*} [Fintype ι] [DecidableEq ι] [CommRing R]
    (p : TwinPolynomials ι R) :
    p ∈ booleanTwinIdeal ι R ↔ ∀ x : ι → Bool, assignmentEval x p = 0 := by
  classical
  let I := booleanTwinIdeal ι R
  constructor
  · intro hp x
    have h : I ≤ RingHom.ker (assignmentEval (R:=R) x) := by
      unfold I booleanTwinIdeal
      apply Ideal.span_le.mpr
      intro q hq
      rcases hq with ⟨i,rfl⟩ | ⟨j,rfl⟩
      · apply RingHom.mem_ker.mpr
        simp only [map_sub,map_pow,assignmentEval_X,Sum.elim_inl]
        cases hx : x i <;> simp [hx,boolValue]
      · apply RingHom.mem_ker.mpr
        simp [assignmentEval_X]
    exact RingHom.mem_ker.mp (h hp)
  · intro hp
    let Q := TwinPolynomials ι R ⧸ I
    let mk : TwinPolynomials ι R →+* Q := Ideal.Quotient.mk I
    let r := fun i : ι => mk (X (.inl i))
    let w := fun i : ι => mk (X (.inr i))
    have hB (i : ι) : r i*r i = r i := by
      have hI : (X (.inl i):TwinPolynomials ι R)^2-X (.inl i) ∈ I :=
        Ideal.subset_span (Or.inl ⟨i,rfl⟩)
      have h := Ideal.Quotient.eq_zero_iff_mem.mpr hI
      change mk _ = 0 at h
      rw [map_sub,map_pow,pow_two,sub_eq_zero] at h
      exact h
    have hT (i : ι) : w i = 1-r i := by
      have hI : (X (.inl i):TwinPolynomials ι R)+X (.inr i)-1 ∈ I :=
        Ideal.subset_span (Or.inr ⟨i,rfl⟩)
      have h := Ideal.Quotient.eq_zero_iff_mem.mpr hI
      change mk _ = 0 at h
      rw [map_sub,map_add,map_one,sub_eq_zero] at h
      change r i+w i=1 at h
      exact (eq_sub_iff_add_eq.mpr (by rwa [add_comm]))
    let piece : ι → Bool → Q := fun i b => if b then r i else 1-r i
    let e : (ι → Bool) → Q := fun x => ∏ i, piece i (x i)
    have hOne : (∑ x : ι → Bool, e x) = 1 := by
      unfold e
      rw [←Fintype.prod_sum]
      apply Finset.prod_eq_one
      intro i _
      have h : (univ : Finset Bool) = {false,true} := by decide
      rw [h]
      simp [piece]
    have hA (x : ι → Bool) (i : ι) :
        r i*e x = mk (C (boolValue (x i)))*e x := by
      have hE : e x = piece i (x i)*∏ j ∈ (univ : Finset ι).erase i, piece j (x j) :=
        (Finset.mul_prod_erase _ _ (Finset.mem_univ i)).symm
      rw [hE,←mul_assoc,←mul_assoc]
      congr 1
      cases hx : x i
      · simp only [hx,piece,boolValue,Bool.false_eq_true,if_false,C_0,map_zero,zero_mul]
        rw [mul_sub,mul_one,hB,sub_self]
      · simp [hx,piece,boolValue,hB]
    have hMul (x : ι → Bool) (i : ι ⊕ ι) :
        mk (X i)*e x = mk (C (assignmentEval x (X i)))*e x := by
      rcases i with i|i
      · rw [assignmentEval_X]
        exact hA x i
      · change w i*e x = _
        rw [assignmentEval_X,hT,sub_mul,one_mul,hA x i]
        simp only [Sum.elim_inr,map_sub,map_one,C_1,C_sub,sub_mul,one_mul]
    have hP (x : ι → Bool) (q : TwinPolynomials ι R) :
        mk q*e x = mk (C (assignmentEval x q))*e x := by
      induction q using MvPolynomial.induction_on with
      | C c => rw [assignmentEval_C]
      | add u v hu hv =>
        rw [map_add,add_mul,hu,hv,map_add,map_add,map_add,add_mul]
      | mul_X u i hu =>
        rw [map_mul,map_mul,map_mul,map_mul,mul_assoc,hMul,←mul_assoc,
          mul_comm (mk u),mul_assoc,hu,←mul_assoc,mul_comm (mk (C (assignmentEval x (X i))))]
    apply Ideal.Quotient.eq_zero_iff_mem.mp
    change mk p = 0
    calc
      _ = mk p*∑ x : ι → Bool, e x := by rw [hOne,mul_one]
      _ = ∑ x : ι → Bool, mk p*e x := Finset.mul_sum _ _ _
      _ = 0 := by
        apply Finset.sum_eq_zero
        intro x _
        rw [hP x p,hp x,C_0,map_zero,zero_mul]

end PHP
